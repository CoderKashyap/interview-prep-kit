# Copy this file to .env in the repo root (and/or backend/.env).
# The evaluate command and the API both read these names.

# MongoDB — local or Atlas free tier
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep_kit

# Session secret for signing JWTs (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini — genuine free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional fallback if Gemini is unset
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Frontend (also put these in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production fetch policy: block private/loopback hosts. Evaluate CLI always allows localhost.
ALLOW_PRIVATE_URLS=false
