{
  "name": "interview-prep-kit",
  "private": true,
  "workspaces": [
    "pipeline",
    "backend",
    "frontend"
  ],
  "scripts": {
    "evaluate": "tsx pipeline/src/evaluate.ts",
    "test": "npm test -w pipeline",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "node -e \"console.log('Skip compile on Render. Start the API with npm run start -w backend. Build the UI on Vercel.')\"",
    "build:web": "npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
