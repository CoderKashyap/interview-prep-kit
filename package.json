{
  "name": "interview-prep-kit",
  "private": true,
  "workspaces": [
    "pipeline",
    "backend",
    "frontend"
  ],
  "scripts": {
    "evaluate": "tsx pipeline/src/evaluate.ts",
    "test": "npm test -w pipeline",
    "dev:api": "npm run dev -w backend",
